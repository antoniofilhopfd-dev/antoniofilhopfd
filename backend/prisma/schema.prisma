// Schema da aplicação Evolução Tráfego.
// Etapa 1: SystemStatus (diagnóstico).
// Etapa 2: User, Session (acesso e perfis).
// Etapa 4: DailyMetric (métricas diárias no nível da conta).
// Etapa 5: Campaign, AdSet, Ad, AdDailyMetric (hierarquia e classificação).
// Demais modelos de domínio entram nas etapas 6, 7, 9, 10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemStatus {
  id        String   @id @default(uuid())
  component String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  // Só tem efeito para MANAGER: permite enviar rascunhos à Meta.
  // Concedida individualmente por um ADMIN (Seção 5/12 da especificação).
  canSubmitToMeta    Boolean  @default(false)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  createdBy          User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]   @relation("UserCreatedBy")

  sessions           Session[]
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

// Métricas diárias no nível da conta (hipótese de uma instituição/uma
// conta, Seção 20). "results" = conversas iniciadas (decisão registrada
// na Seção 20; não é matrícula nem lead — Seção 9).
// reach/frequency NÃO devem ser somados entre dias para representar
// pessoas únicas da semana (Seção 9) — ficam disponíveis só por dia.
model DailyMetric {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  resultsConversations Int
  reach         Int
  impressions   Int
  frequency     Decimal  @db.Decimal(6, 3)
  clicksTotal   Int
  clicksLink    Int
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date])
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// Segmentos propostos na Seção 10 (a confirmar se já existir classificação
// anterior; hipótese de trabalho enquanto não há material do protótipo).
enum Segment {
  EDUCACAO_INFANTIL
  ANOS_INICIAIS
  ANOS_FINAIS
  ENSINO_MEDIO
  INSTITUCIONAL
  OUTROS
}

// Hierarquia campanha -> conjunto -> anúncio (Seção 10). Métricas diárias
// são armazenadas no nível do Anúncio (folha); totais de Conjunto e
// Campanha são somados a partir dos anúncios filhos nesta etapa —
// simplificação a revisar na Etapa 6, quando a API do Meta fornecer
// agregados próprios por nível (podem não ser idênticos à soma dos filhos).
model Campaign {
  id            String       @id @default(uuid())
  externalId    String       @unique
  name          String
  status        EntityStatus
  objective     String
  segment       Segment?
  // "manual" = classificado por um usuário e protegido contra sobrescrita
  // por importação futura (Seção 10). null = ainda não classificado.
  segmentSource String?
  isDemo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  adSets AdSet[]

  @@index([status])
  @@index([segment])
}

model AdSet {
  id          String       @id @default(uuid())
  externalId  String       @unique
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  status      EntityStatus
  dailyBudget Decimal      @db.Decimal(10, 2)
  isDemo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ads Ad[]

  @@index([campaignId])
  @@index([status])
}

model Ad {
  id         String       @id @default(uuid())
  externalId String       @unique
  adSetId    String
  adSet      AdSet        @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name       String
  status     EntityStatus
  isDemo     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  dailyMetrics AdDailyMetric[]

  @@index([adSetId])
  @@index([status])
}

model AdDailyMetric {
  id                   String   @id @default(uuid())
  adId                 String
  ad                   Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date                 DateTime @db.Date
  spend                Decimal  @db.Decimal(12, 2)
  resultsConversations Int
  reach                Int
  impressions          Int
  frequency            Decimal  @db.Decimal(6, 3)
  clicksTotal          Int
  clicksLink           Int
  isDemo               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([adId, date])
  @@index([date])
}
