// Schema da aplicação Evolução Tráfego.
// Etapa 1: SystemStatus (diagnóstico).
// Etapa 2: User, Session (acesso e perfis).
// Etapa 4: DailyMetric (métricas diárias no nível da conta).
// Demais modelos de domínio entram nas etapas 5, 6, 7, 9, 10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemStatus {
  id        String   @id @default(uuid())
  component String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  // Só tem efeito para MANAGER: permite enviar rascunhos à Meta.
  // Concedida individualmente por um ADMIN (Seção 5/12 da especificação).
  canSubmitToMeta    Boolean  @default(false)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  createdBy          User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]   @relation("UserCreatedBy")

  sessions           Session[]
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

// Métricas diárias no nível da conta (hipótese de uma instituição/uma
// conta, Seção 20). "results" = conversas iniciadas (decisão registrada
// na Seção 20; não é matrícula nem lead — Seção 9).
// reach/frequency NÃO devem ser somados entre dias para representar
// pessoas únicas da semana (Seção 9) — ficam disponíveis só por dia.
model DailyMetric {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  resultsConversations Int
  reach         Int
  impressions   Int
  frequency     Decimal  @db.Decimal(6, 3)
  clicksTotal   Int
  clicksLink    Int
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date])
}
