// Schema da aplicação Evolução Tráfego.
// Etapa 1: SystemStatus (diagnóstico).
// Etapa 2: User, Session (acesso e perfis).
// Etapa 4: DailyMetric (métricas diárias no nível da conta).
// Etapa 5: Campaign, AdSet, Ad, AdDailyMetric (hierarquia e classificação).
// Etapa 6: MetaConnection, SyncLog (integração Meta, leitura limitada).
// Etapa 8: WeeklyObservation (observações com autoria, relatórios).
// Etapa 9: Draft (rascunhos de campanha/conjunto/anúncio, com imagem).
// Incremento "Relatório Executivo": ReportConclusion (conclusão do
// responsável por semana) + perfil Relatório (reaproveita VIEWER).
// Etapa 10: campos de envio (criação pausada) no Draft.
// Demais modelos de domínio entram na etapa 10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemStatus {
  id        String   @id @default(uuid())
  component String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  // Só tem efeito para MANAGER: permite enviar rascunhos à Meta.
  // Concedida individualmente por um ADMIN (Seção 5/12 da especificação).
  canSubmitToMeta    Boolean  @default(false)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  createdBy          User?    @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]   @relation("UserCreatedBy")

  sessions           Session[]
  weeklyObservations WeeklyObservation[]
  drafts             Draft[]
  reportConclusions  ReportConclusion[]
  submittedDrafts    Draft[] @relation("DraftSubmittedBy")
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

// Métricas diárias no nível da conta (hipótese de uma instituição/uma
// conta, Seção 20). "results" = conversas iniciadas (decisão registrada
// na Seção 20; não é matrícula nem lead — Seção 9).
// reach/frequency NÃO devem ser somados entre dias para representar
// pessoas únicas da semana (Seção 9) — ficam disponíveis só por dia.
model DailyMetric {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  spend         Decimal  @db.Decimal(12, 2)
  resultsConversations Int
  reach         Int
  impressions   Int
  frequency     Decimal  @db.Decimal(6, 3)
  clicksTotal   Int
  clicksLink    Int
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date])
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// Segmentos propostos na Seção 10 (a confirmar se já existir classificação
// anterior; hipótese de trabalho enquanto não há material do protótipo).
enum Segment {
  EDUCACAO_INFANTIL
  ANOS_INICIAIS
  ANOS_FINAIS
  ENSINO_MEDIO
  INSTITUCIONAL
  OUTROS
}

// Hierarquia campanha -> conjunto -> anúncio (Seção 10). Métricas diárias
// são armazenadas no nível do Anúncio (folha); totais de Conjunto e
// Campanha são somados a partir dos anúncios filhos nesta etapa —
// simplificação a revisar na Etapa 6, quando a API do Meta fornecer
// agregados próprios por nível (podem não ser idênticos à soma dos filhos).
model Campaign {
  id            String       @id @default(uuid())
  externalId    String       @unique
  name          String
  status        EntityStatus
  objective     String
  segment       Segment?
  // "manual" = classificado por um usuário e protegido contra sobrescrita
  // por importação futura (Seção 10). null = ainda não classificado.
  segmentSource String?
  isDemo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  adSets AdSet[]

  @@index([status])
  @@index([segment])
}

model AdSet {
  id          String       @id @default(uuid())
  externalId  String       @unique
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  status      EntityStatus
  dailyBudget Decimal      @db.Decimal(10, 2)
  isDemo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ads Ad[]

  @@index([campaignId])
  @@index([status])
}

model Ad {
  id         String       @id @default(uuid())
  externalId String       @unique
  adSetId    String
  adSet      AdSet        @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  name       String
  status     EntityStatus
  isDemo     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  dailyMetrics AdDailyMetric[]

  @@index([adSetId])
  @@index([status])
}

model AdDailyMetric {
  id                   String   @id @default(uuid())
  adId                 String
  ad                   Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  date                 DateTime @db.Date
  spend                Decimal  @db.Decimal(12, 2)
  resultsConversations Int
  reach                Int
  impressions          Int
  frequency            Decimal  @db.Decimal(6, 3)
  clicksTotal          Int
  clicksLink           Int
  isDemo               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([adId, date])
  @@index([date])
}

// Linha única (singleton) com o estado da integração Meta. Token, conta
// e versão da API são configurados exclusivamente por variável de
// ambiente (Seção 11) — nunca editáveis pela interface.
model MetaConnection {
  id                String    @id @default("singleton")
  configured        Boolean   @default(false)
  connectionStatus  String    @default("not_configured") // not_configured | ok | invalid_token | error
  accountId         String?
  accountName       String?
  lastCheckedAt     DateTime?
  lastCheckedError  String?
  lastSyncAt        DateTime?
  lastSyncStatus    String? // success | partial | failed
  lastSyncError     String?
  isSyncing         Boolean   @default(false)
  updatedAt         DateTime  @updatedAt
}

model SyncLog {
  id              String    @id @default(uuid())
  type            String // hierarchy | insights
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String // success | failed
  itemsProcessed  Int       @default(0)
  errorMessage    String?
  triggeredById   String?

  @@index([startedAt])
}

// Observações semanais do gestor, com autoria (Seção 5/9/13). Várias
// observações por semana são permitidas (cada uma com seu autor e
// horário), em vez de um campo único sobrescrito.
model WeeklyObservation {
  id        String   @id @default(uuid())
  weekStart DateTime @db.Date
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
}

enum CallToAction {
  SAIBA_MAIS
  CADASTRE_SE
  FALE_CONOSCO
  GARANTA_JA
}

// Rascunho de campanha/conjunto/anúncio (Seção 12). Escopo desta etapa:
// tráfego para site HTTPS com imagem, um conjunto e um anúncio por
// rascunho, orçamento em BRL, público amplo por país/idade. Persistido
// incrementalmente (cada campo salvo ao editar); envio real (status
// PAUSED na Meta) é a Etapa 10 — aqui o rascunho nunca é enviado.
model Draft {
  id          String   @id @default(uuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  // Campanha
  campaignName String?

  // Conjunto
  adSetName   String?
  dailyBudget Decimal? @db.Decimal(10, 2)
  country     String?  @default("BR")
  ageMin      Int?
  ageMax      Int?

  // Anúncio
  adName           String?
  facebookPageName String?
  title            String?
  bodyText         String?
  destinationUrl   String?
  callToAction     CallToAction?

  // Imagem (armazenamento local nesta fase — Seção 15; metadados aqui,
  // bytes em disco em backend/uploads/drafts/, nunca no repositório).
  imageFilename     String?
  imageOriginalName String?
  imageMimeType     String?
  imageSize         Int?

  // Envio (Etapa 10 — criação pausada). Cada identificador é persistido
  // assim que a Meta confirma a criação daquele objeto, permitindo
  // retomar só a partir do que já foi criado (Seção 12: "Impedir
  // concorrência e repetição... retomar somente etapas seguramente
  // confirmadas"). AMBIGUOUS_BLOCKED trava reenvio automático quando a
  // resposta da Meta é indeterminada (ex.: falha de rede na criação).
  submissionStatus            DraftSubmissionStatus @default(NOT_SUBMITTED)
  submittedCampaignExternalId String?
  submittedAdSetExternalId    String?
  submittedCreativeExternalId String?
  submittedAdExternalId       String?
  submittedAt                 DateTime?
  submittedById                String?
  submittedBy                  User?    @relation("DraftSubmittedBy", fields: [submittedById], references: [id])
  lastSubmissionError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

enum DraftSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTING
  SUBMITTED
  FAILED
  AMBIGUOUS_BLOCKED
}

// Conclusão do responsável (Admin/Gestor) por semana — campo manual,
// uma por semana (upsert), nunca substituída por texto automático.
// O perfil Relatório (VIEWER) só visualiza.
model ReportConclusion {
  id        String   @id @default(uuid())
  weekStart DateTime @unique @db.Date
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
