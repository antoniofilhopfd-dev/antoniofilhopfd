# Copie este arquivo para .env e ajuste os valores para o seu ambiente local.

# Conexão com o PostgreSQL usado pela aplicação Evolução Tráfego (banco novo, separado do protótipo).
DATABASE_URL="postgresql://evolucao_trafego:evolucao_dev_local@localhost:5432/evolucao_trafego?schema=public"

# Porta HTTP do backend Express.
PORT=3333

# Origem permitida para requisições do frontend (CORS) em desenvolvimento.
FRONTEND_ORIGIN="http://localhost:5173"

# Integração Meta (Etapa 6) — configuração exclusiva no servidor (Seção 11).
# Sem essas duas variáveis, a integração fica "não configurada" e nenhuma
# conexão é simulada. Versão da API fixada em src/meta/config.ts.
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Agendamento automático opcional (Etapa 7) — intervalo em minutos entre
# sincronizações enquanto ESTE processo estiver rodando. Deixe ausente
# para manter o agendamento desligado (padrão).
# META_SYNC_INTERVAL_MINUTES=60
